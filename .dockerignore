# Build context for every service image is the repo root (compose: context ../..).
# Images install their own dependencies from the lockfiles; keep local state out.
.git
.env
.env.*
!.env.example

**/node_modules
**/.venv
**/.venv.*
**/dist
**/.next
**/*.tsbuildinfo
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/storybook-static
**/playwright-report
**/test-results
services/admin-ui/e2e/.auth
