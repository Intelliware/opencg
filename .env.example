# --- Environment and authentication ------------------------------------------
# Which deployment this is: dev, test, staging or production. The services treat
# an UNSET value as production; this file (and the compose stack) default to dev.
# API keys (OPENCG__AUTH__API_KEYS_FILE, OPENCG__MCP__HTTP_TOKEN) work only in dev.
OPENCG__ENVIRONMENT=dev

# none = open single-user mode: every request runs as the stub identity below,
#        the admin UI shows an "Unauthenticated mode" banner, and the services
#        refuse to start if OPENCG__BIND_ADDRESS is not loopback.
# oidc = every request needs an access token from the issuer below.
OPENCG__AUTH__MODE=none

# Stub identity, used only in `none` mode.
OPENCG__IDENTITY__PRINCIPAL=local-dev
OPENCG__IDENTITY__ROLES=admin,reader
OPENCG__TENANT=default

# OIDC with the BUNDLED Keycloak: uncomment these. `make up-d` then also starts
# the `keycloak` service (http://localhost:8380, admin console user `admin`).
# OPENCG__AUTH__MODE=oidc
# OPENCG__AUTH__OIDC__ISSUER=http://localhost:8380/realms/opencg
# OPENCG__AUTH__OIDC__INTERNAL_URL=http://keycloak:8080/realms/opencg
#
# OIDC with YOUR IdP (Entra ID, Okta, Auth0, Keycloak...): set the issuer to its
# public issuer URL and leave INTERNAL_URL unset. See docs/OPERATIONS.md.
# OPENCG__AUTH__OIDC__ISSUER=https://login.example.com/realms/opencg
# Required `aud` value, and where principal / roles / tenant come from (dotted
# claim paths, e.g. realm_access.roles or groups; empty tenant claim = OPENCG__TENANT).
# OPENCG__AUTH__OIDC__AUDIENCE=opencg
# OPENCG__AUTH__OIDC__PRINCIPAL_CLAIM=preferred_username
# OPENCG__AUTH__OIDC__ROLES_CLAIM=roles
# OPENCG__AUTH__OIDC__TENANT_CLAIM=
# Admin UI sign-in client (authorization code + PKCE) and the browser-facing URL
# its redirect and sign-out URIs derive from.
# OPENCG__ADMIN_UI__OIDC__CLIENT_ID=opencg-admin-ui
# OPENCG__ADMIN_UI__PUBLIC_URL=http://localhost:3000
# The MCP server's externally reachable base URL (protected-resource metadata
# tells OAuth clients like claude.ai which IdP to use), e.g. an ngrok HTTPS URL.
# OPENCG__MCP__PUBLIC_URL=http://localhost:8181
# stdio MCP transport in oidc mode: a bearer token for the local process.
# OPENCG__MCP__STDIO_TOKEN=
# Dev-only named API keys (JSON list of {name, key_sha256, principal, roles};
# create one with `make api-key`). Refused at startup outside OPENCG__ENVIRONMENT=dev.
# OPENCG__AUTH__API_KEYS_FILE=

# --- Policy (OPA) -------------------------------------------------------------
# Entitlement and admin-action decisions, in both auth modes. Policies and data
# live in infra/opa/. Unreachable or slower than the timeout = request denied.
OPENCG__OPA__URL=http://opa:8181
# OPENCG__OPA__TIMEOUT_MS=2000

# --- Bundled Keycloak (only started in oidc mode with the bundled issuer) -----
# DEVELOPMENT-ONLY VALUES. Every value in this section is public (it is in git).
# They are fine for a loopback-only local stack, smoke, e2e and CI. CHANGE ALL OF
# THEM before Keycloak is reachable from any network, and use your own IdP in
# staging/production. Keycloak reads them at first realm import; changing them
# later needs `make down-v` (or editing the realm in the Keycloak console).
# Keycloak's own database on the stack's Postgres. Created with the volume
# (infra/postgres/init/015_keycloak_db.sh); on an existing volume run
# `make db-apply SQL=015_keycloak_db.sh`.
OPENCG__KEYCLOAK__DB_PASSWORD=dev-only-keycloak-db
# Keycloak admin console (http://localhost:8380/admin, user `admin`).
OPENCG__KEYCLOAK__ADMIN_PASSWORD=dev-only-keycloak-admin
# Confidential client `opencg-admin-ui`; the admin UI sends it to the token endpoint.
OPENCG__ADMIN_UI__OIDC__CLIENT_SECRET=dev-only-admin-ui-secret
# Client-credentials service accounts used by smoke and e2e (dev/test only):
# opencg-smoke (admin, reader), opencg-smoke-reader (reader),
# opencg-smoke-legal (reader, legal).
OPENCG__SMOKE__CLIENT_SECRET=dev-only-smoke-secret
OPENCG__SMOKE_READER__CLIENT_SECRET=dev-only-smoke-reader-secret
OPENCG__SMOKE_LEGAL__CLIENT_SECRET=dev-only-smoke-legal-secret
# Dev users, imported only when OPENCG__ENVIRONMENT is dev or test:
# alice (admin, reader), bob (reader), carol (reader, legal).
OPENCG__IDP__ALICE_PASSWORD=dev-only-alice
OPENCG__IDP__BOB_PASSWORD=dev-only-bob
OPENCG__IDP__CAROL_PASSWORD=dev-only-carol

# --- Storage ----------------------------------------------------------------
# Postgres credentials. Compose creates the database with these and derives
# OPENCG__POSTGRES__URL from them. CHANGE THE PASSWORD for anything beyond local
# use. (Changing it after first start needs `make down-v` or a manual ALTER ROLE,
# because Postgres only applies it when the volume is first initialised.) SECRET.
OPENCG__POSTGRES__USER=opencg
OPENCG__POSTGRES__PASSWORD=opencg
OPENCG__POSTGRES__DB=opencg
# Set this only to use an external database instead of the compose one:
# OPENCG__POSTGRES__URL=postgresql://user:pass@host:5432/db
OPENCG__QDRANT__URL=http://qdrant:6333
OPENCG__VALKEY__URL=redis://valkey:6379/0

# --- Model providers --------------------------------------------------------
# The v0 stack ships its own Ollama service in compose at http://ollama:11434.
# The configured embedding model is pulled on first start of that container.
OPENCG__OLLAMA__BASE_URL=http://ollama:11434
OPENCG__OLLAMA__EMBEDDING_MODEL=nomic-embed-text

# Optional alternatives (uncomment + set as needed):
#   * Host Ollama via Docker Desktop:    http://host.docker.internal:11434
#   * Ollama Cloud (chat-only in v0):    https://ollama.com   (see note below)
# OPENCG__OLLAMA__BASE_URL=http://host.docker.internal:11434

# Ollama Cloud API key. The thin MVP does NOT use Cloud for embeddings — Cloud
# gates /api/embed on the reference account (see
# openspec/changes/archive/2026-11-10-bootstrap-thin-mvp/design.md D1). The key is reserved for
# follow-up changes that introduce chat / intent / generation paths.
# SECRET — never commit.
# OPENCG__OLLAMA__API_KEY=

# The graph extractor uses an independently configurable Ollama chat endpoint.
# Keep the key in `.env`; never place it in opencg.yaml.
OPENCG__PROVIDERS__CHAT__BASE_URL=https://ollama.com
OPENCG__PROVIDERS__CHAT__MODEL=gemma4:31b
# OPENCG__PROVIDERS__CHAT__API_KEY=

# Best-effort text extraction controls.
OPENCG__PROVIDERS__EXTRACTION__ENABLED=true
OPENCG__PROVIDERS__EXTRACTION__MIN_CONFIDENCE=0.6
OPENCG__PROVIDERS__EXTRACTION__TIMEOUT_SECONDS=30

# Anthropic key is optional in MVP (used in follow-ups for intent + generation).
# ANTHROPIC_API_KEY=

# --- Ingestion URL guard ----------------------------------------------------
# URLs submitted through the admin UI / HTTP API must be https://, ssh://,
# git:// or user@host:path, and must resolve to a public address.
# Comma-separated hosts allowed to resolve to private addresses (internal git):
# OPENCG__INGESTION__GIT__ALLOWED_HOSTS=git.internal.example
# Comma-separated directories (inside the ingestion container) that local repo
# paths may live under. Empty = local paths are refused. The smoke overlay sets /tmp.
# OPENCG__INGESTION__GIT__LOCAL_ROOTS=

# --- Host ports --------------------------------------------------------------
# Every published port binds to OPENCG__BIND_ADDRESS (loopback by default).
# Set it to 0.0.0.0 ONLY to expose the stack on your network, and only after
# setting real passwords/tokens. Change any host port below to dodge a clash.
# OPENCG__BIND_ADDRESS=127.0.0.1
# OPENCG__ADMIN_UI__HOST_PORT=3000
# OPENCG__PIPELINE__HOST_PORT=8000
# OPENCG__INGESTION__HOST_PORT=8100
# OPENCG__MCP__HOST_PORT=8181
# OPENCG__POSTGRES__HOST_PORT=5432
# OPENCG__QDRANT__HOST_PORT=6333
# OPENCG__QDRANT__GRPC_HOST_PORT=6334
# OPENCG__VALKEY__HOST_PORT=6379
# OPENCG__OLLAMA__HOST_PORT=11435     # 11435 avoids a native Ollama on 11434
# OPENCG__OTEL__HTTP_HOST_PORT=4318
# OPENCG__OTEL__HEALTH_HOST_PORT=13133
# OPENCG__OPA__HOST_PORT=8281         # 8181 is the MCP server's host port
# OPENCG__KEYCLOAK__HOST_PORT=8380    # change OPENCG__AUTH__OIDC__ISSUER with it
# Keycloak's public base URL (token `iss`, browser redirects). Defaults to
# http://localhost:${OPENCG__KEYCLOAK__HOST_PORT}; must match the issuer above.
# OPENCG__KEYCLOAK__PUBLIC_URL=http://localhost:8380

# --- Service URLs (compose-internal) ---------------------------------------
OPENCG__PIPELINE__URL=http://pipeline:8000
OPENCG__MCP__PORT=8080
OPENCG__ADMIN_UI__URL=http://admin-ui:3000

# Legacy static bearer for `/mcp`, accepted ONLY when OPENCG__ENVIRONMENT=dev
# (as the API key `mcp-http-token`). Prefer a named API key (`make api-key`) or,
# outside dev, OIDC (OPENCG__AUTH__MODE=oidc). SECRET — never commit.
# OPENCG__MCP__HTTP_TOKEN=

# The shared-password OAuth stopgap (OPENCG__MCP__OAUTH_PASSWORD) and the admin UI
# password gate (OPENCG__ADMIN_UI__PASSWORD) were removed; services refuse to
# start if either is set. See docs/OPERATIONS.md "Migrating from the stopgaps".

# --- Observability ----------------------------------------------------------
# The dev compose profile includes an OTLP/HTTP collector on this hostname.
# Set to `none` only for an explicit offline run; smoke will visibly skip its
# trace assertions in that mode.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAMESPACE=opencg
# OTEL_LOG_LEVEL=debug

# --- Observability (only used with `make up-obs`) ----------------------------
# Prometheus, Tempo and Grafana are OPTIONAL and NOT part of the default stack:
# `make up-d`, `make smoke` and `make e2e` never start them. `make up-obs` adds
# them (about 400-700 MB more RAM); `make down` removes them again. These keys
# do nothing without the overlay. See docs/OPERATIONS.md § Observability.
# Grafana login is admin / this password. CHANGE IT for anything beyond local
# use. SECRET.
# OPENCG__GRAFANA__ADMIN_PASSWORD=admin
# Host ports (loopback, like every other port). Grafana defaults to 3030, not
# 3001, because the e2e overlay's gated admin UI uses 3001.
# OPENCG__GRAFANA__HOST_PORT=3030
# OPENCG__PROMETHEUS__HOST_PORT=9090
# OPENCG__TEMPO__HOST_PORT=3200
# How long Prometheus keeps metrics (also capped at 2 GB). Tempo keeps traces 48 h.
# OPENCG__PROMETHEUS__RETENTION=7d

# --- Smoke test -------------------------------------------------------------
# Default smoke uses the local deterministic chat stub and finishes within
# five minutes on an already-built healthy stack.
# SMOKE_CHAT_MODE=stub
# SMOKE_TIMEOUT_SECONDS=300
# Set SMOKE_CHAT_MODE=cloud only for the opt-in one-document/two-chunk canary.

# --- Retrieval defaults -----------------------------------------------------
OPENCG__RETRIEVAL__DEFAULT_TOP_K=20
OPENCG__RETRIEVAL__DEFAULT_TOKEN_BUDGET=4000
