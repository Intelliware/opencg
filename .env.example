# --- Identity stub (v0 — REPLACE BEFORE PROD) -------------------------------
OPENCG__IDENTITY__PRINCIPAL=local-dev
OPENCG__IDENTITY__ROLES=admin,reader
OPENCG__TENANT=default

# --- Storage ----------------------------------------------------------------
# Postgres credentials. Compose creates the database with these and derives
# OPENCG__POSTGRES__URL from them. CHANGE THE PASSWORD for anything beyond local
# use. (Changing it after first start needs `make down-v` or a manual ALTER ROLE,
# because Postgres only applies it when the volume is first initialised.) SECRET.
OPENCG__POSTGRES__USER=opencg
OPENCG__POSTGRES__PASSWORD=opencg
OPENCG__POSTGRES__DB=opencg
# Set this only to use an external database instead of the compose one:
# OPENCG__POSTGRES__URL=postgresql://user:pass@host:5432/db
OPENCG__QDRANT__URL=http://qdrant:6333
OPENCG__VALKEY__URL=redis://valkey:6379/0

# --- Model providers --------------------------------------------------------
# The v0 stack ships its own Ollama service in compose at http://ollama:11434.
# The configured embedding model is pulled on first start of that container.
OPENCG__OLLAMA__BASE_URL=http://ollama:11434
OPENCG__OLLAMA__EMBEDDING_MODEL=nomic-embed-text

# Optional alternatives (uncomment + set as needed):
#   * Host Ollama via Docker Desktop:    http://host.docker.internal:11434
#   * Ollama Cloud (chat-only in v0):    https://ollama.com   (see note below)
# OPENCG__OLLAMA__BASE_URL=http://host.docker.internal:11434

# Ollama Cloud API key. The thin MVP does NOT use Cloud for embeddings — Cloud
# gates /api/embed on the reference account (see
# openspec/changes/archive/2026-11-10-bootstrap-thin-mvp/design.md D1). The key is reserved for
# follow-up changes that introduce chat / intent / generation paths.
# SECRET — never commit.
# OPENCG__OLLAMA__API_KEY=

# The graph extractor uses an independently configurable Ollama chat endpoint.
# Keep the key in `.env`; never place it in opencg.yaml.
OPENCG__PROVIDERS__CHAT__BASE_URL=https://ollama.com
OPENCG__PROVIDERS__CHAT__MODEL=gemma3:4b
# OPENCG__PROVIDERS__CHAT__API_KEY=

# Best-effort text extraction controls.
OPENCG__PROVIDERS__EXTRACTION__ENABLED=true
OPENCG__PROVIDERS__EXTRACTION__MIN_CONFIDENCE=0.6
OPENCG__PROVIDERS__EXTRACTION__TIMEOUT_SECONDS=30

# Anthropic key is optional in MVP (used in follow-ups for intent + generation).
# ANTHROPIC_API_KEY=

# --- Admin UI access gate (stopgap — REPLACE BEFORE PROD) --------------------
# Unset = no login: the admin UI shows an "Unauthenticated mode" banner and its
# delete, ingest and graph-edit actions are open to anyone who can reach it.
# Set a shared password to require a sign-in (12-hour session cookie) on every
# page and /api/proxy route. Changing it signs everyone out. SECRET.
# OPENCG__ADMIN_UI__PASSWORD=

# --- Ingestion URL guard ----------------------------------------------------
# URLs submitted through the admin UI / HTTP API must be https://, ssh://,
# git:// or user@host:path, and must resolve to a public address.
# Comma-separated hosts allowed to resolve to private addresses (internal git):
# OPENCG__INGESTION__GIT__ALLOWED_HOSTS=git.internal.example
# Comma-separated directories (inside the ingestion container) that local repo
# paths may live under. Empty = local paths are refused. The smoke overlay sets /tmp.
# OPENCG__INGESTION__GIT__LOCAL_ROOTS=

# --- Host ports --------------------------------------------------------------
# Every published port binds to OPENCG__BIND_ADDRESS (loopback by default).
# Set it to 0.0.0.0 ONLY to expose the stack on your network, and only after
# setting real passwords/tokens. Change any host port below to dodge a clash.
# OPENCG__BIND_ADDRESS=127.0.0.1
# OPENCG__ADMIN_UI__HOST_PORT=3000
# OPENCG__PIPELINE__HOST_PORT=8000
# OPENCG__INGESTION__HOST_PORT=8100
# OPENCG__MCP__HOST_PORT=8181
# OPENCG__POSTGRES__HOST_PORT=5432
# OPENCG__QDRANT__HOST_PORT=6333
# OPENCG__QDRANT__GRPC_HOST_PORT=6334
# OPENCG__VALKEY__HOST_PORT=6379
# OPENCG__OLLAMA__HOST_PORT=11435     # 11435 avoids a native Ollama on 11434
# OPENCG__OTEL__HTTP_HOST_PORT=4318
# OPENCG__OTEL__HEALTH_HOST_PORT=13133

# --- Service URLs (compose-internal) ---------------------------------------
OPENCG__PIPELINE__URL=http://pipeline:8000
OPENCG__MCP__PORT=8080
OPENCG__ADMIN_UI__URL=http://admin-ui:3000

# Bearer token for the MCP server's HTTP transport at `/mcp`. Leave unset for
# local-only use (the server logs an "unauthenticated" warning); SET IT before
# exposing the MCP port beyond loopback (e.g. via a tunnel). SECRET — never commit.
# Works with Claude Code / Cursor (they send a bearer header); claude.ai needs OAuth (below).
# OPENCG__MCP__HTTP_TOKEN=

# --- MCP OAuth (stopgap) ---------------------------------------------------
# claude.ai / Claude Desktop's custom-connector GUI authenticate via OAuth, not
# a bearer header. Set both of these to enable a TEMPORARY shared-password OAuth
# server on /mcp (see services/mcp-server/src/oauth.ts — REPLACE-BEFORE-PROD).
# PUBLIC_URL is the externally reachable base URL (e.g. your ngrok HTTPS URL),
# used in the OAuth metadata. OAUTH_PASSWORD gates the /authorize step. SECRET.
# OPENCG__MCP__PUBLIC_URL=https://your-host.ngrok.app
# OPENCG__MCP__OAUTH_PASSWORD=

# --- Observability ----------------------------------------------------------
# The dev compose profile includes an OTLP/HTTP collector on this hostname.
# Set to `none` only for an explicit offline run; smoke will visibly skip its
# trace assertions in that mode.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAMESPACE=opencg
# OTEL_LOG_LEVEL=debug

# --- Smoke test -------------------------------------------------------------
# Default smoke uses the local deterministic chat stub and finishes within
# five minutes on an already-built healthy stack.
# SMOKE_CHAT_MODE=stub
# SMOKE_TIMEOUT_SECONDS=300
# Set SMOKE_CHAT_MODE=cloud only for the opt-in one-document/two-chunk canary.

# --- Retrieval defaults -----------------------------------------------------
OPENCG__RETRIEVAL__DEFAULT_TOP_K=20
OPENCG__RETRIEVAL__DEFAULT_TOKEN_BUDGET=4000
