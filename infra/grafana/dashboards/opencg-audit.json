      "id": 3,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opencg-prometheus"
          },
          "expr": "sum(increase(opencg_audit_writes_total{outcome!=\"ok\"}[$__range])) or vector(0)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Failed audit writes (range)",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "opencg-prometheus"
      },
      "description": "Successful retrieval audit rows per successful pipeline retrieve call. Should stay at 100%.",
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "id": 4,
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opencg-prometheus"
          },
          "expr": "sum(increase(opencg_audit_writes_total{log=\"retrieval\",outcome=\"ok\"}[$__range])) / clamp_min(sum(increase(opencg_requests_total{job=\"pipeline\",tool=\"retrieve_for_context\",outcome=\"ok\"}[$__range])), 1)",
          "instant": true,
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Retrieval audit coverage",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "opencg-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 5,
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "opencg-prometheus"
          },
          "expr": "sum by (log, outcome) (rate(opencg_audit_writes_total[$__rate_interval]))",
          "legendFormat": "{{log}} {{outcome}}",
          "refId": "A"
        }
      ],
      "title": "Audit writes by log and outcome",
      "type": "timeseries"
    }
