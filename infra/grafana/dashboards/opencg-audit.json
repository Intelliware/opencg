    {
      "datasource": {
        "type": "prometheus",
        "uid": "opencg-prometheus"
      },
      "description": "",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
